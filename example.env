# Copy to .env for local Compose; never commit real credentials.
DATABASE_USER=vadat
DATABASE_NAME=vadat
# Use a long URL-safe password (e.g. openssl rand -hex 32).
DATABASE_PASSWORD=
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
IMAGE_TAG=latest
BACKUP_MODE=required
BACKUP_KEEP=10
# Optional Google sign-in; register /api/auth/callback/google on your origin.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
PASSKEY_RP_ID=
