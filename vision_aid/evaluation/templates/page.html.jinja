{% extends 'base.html.jinja' %}
{% from 'evidence.html.jinja' import human_evidence, page_evidence %}
{% from 'charts.html.jinja' import performance_header, detection_overview, page_comparison %}

{% block document_title %}{{ title }}: {{ model_name }}; {{ manifest.source_url }}{% endblock %}
{% block scope %}<p>{{ manifest.source_url }}</p>{% endblock %}
{% block content %}
<section id="performance" aria-labelledby="performance-title">
{{ performance_header(cost, token_usage, model_prices) }}
{{ detection_overview(rates) }}
</section>
<section id="human-findings" aria-labelledby="findings-title">
<h2 id="findings-title">Tool Findings and Human Finding Matches</h2>
<p>Open View details to read the original Human finding, then View page decisions to read the review decision and matched tool findings. Details and page decisions start collapsed.</p>
<div class="findings-panel">
{% include 'controls.html.jinja' %}
<div class="table-scroll" role="region" aria-labelledby="findings-title" tabindex="0">
<table id="findings" aria-labelledby="findings-title">
<thead><tr><th scope="col">Issue title</th><th scope="col">WCAG</th><th scope="col">Expected source</th><th scope="col">LLM</th><th scope="col">Programmatic checks</th><th scope="col">Details</th></tr></thead>
<tbody>
{% for row in rows %}
<tr data-expected="{{ row.expected }}" data-llm="{{ row.llm_outcome }}" data-programmatic="{{ row.programmatic_outcome }}">
<th scope="row">{{ row.human.problem }}</th><td data-print-label="WCAG">{{ row.human.raw_evidence['WCAG Sc'] }}</td><td data-print-label="Expected source">{{ row.expected }}</td><td data-print-label="LLM">{{ row.llm_outcome }}</td><td data-print-label="Programmatic checks">{{ row.programmatic_outcome }}</td>
<td><p data-selected-page-result hidden></p><details><summary>View details</summary>
<div class="evidence">
{{ human_evidence(row) }}
{{ page_evidence(row) }}
</div></details></td>
</tr>
{% endfor %}
</tbody></table></div>
</div>
{% if not rows %}<p>No Human findings were imported for this page.</p>{% endif %}
</section>
{% include 'method.html.jinja' %}
{% endblock %}
